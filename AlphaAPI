import pandas as pd
import requests

def fetch_us_stock_to_csv(ticker, api_key, output_filename):
    """
    Menarik data riwayat harga harian saham Amerika Serikat (dalam USD) 
    dari Alpha Vantage dan menyimpannya menjadi file CSV.
    """
    print(f"Mengambil data saham AS ({ticker}) dalam USD...")
    
    # Endpoint untuk data harian saham AS (tanpa suffix tambahan)
    url = f"https://www.alphavantage.co/query?function=TIME_SERIES_DAILY&symbol={ticker}&apikey={api_key}"
    
    response = requests.get(url)
    data = response.json()
    
    # Validasi error atau limit API
    if "Time Series (Daily)" not in data:
        print("Gagal mengambil data. Pastikan API Key valid dan limit belum tercapai.")
        print("Pesan API:", data)
        return
        
    time_series = data["Time Series (Daily)"]
    
    df = pd.DataFrame.from_dict(time_series, orient='index')
    
    # Penamaan kolom disesuaikan untuk memperjelas mata uang USD
    df.columns = ['Open (USD)', 'High (USD)', 'Low (USD)', 'Close (USD)', 'Volume']
    
    df.index.name = 'Date'
    df.reset_index(inplace=True)
    df.sort_values('Date', inplace=True)
    
    df.to_csv(output_filename, index=False)
    print(f"Sukses! Data telah disimpan di: {output_filename}")

